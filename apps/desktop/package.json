{
  "name": "@dev-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for dev-agent: local web server with a streaming chat UI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dev-agent-desktop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dev-agent/agent-core": "workspace:*",
    "@dev-agent/executor": "workspace:*",
    "@dev-agent/mcp": "workspace:*",
    "@dev-agent/model": "workspace:*",
    "@dev-agent/tools": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test tests-dist/*.test.js",
    "clean": "rm -rf dist tests-dist"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
