{
  "name": "dev-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding agent for developers, built with TypeScript and Node.js.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "node scripts/check.mjs",
    "clean": "pnpm -r clean",
    "cli": "pnpm --filter @dev-agent/cli run start"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
