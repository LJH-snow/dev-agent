export type MouseWheelDirection = "up" | "down";
export type MouseClickAction = "press" | "release";

export interface MouseClick {
  /** The protocol button code, including modifier/motion bits. */
  readonly button: number;
  /** One-based terminal column. */
  readonly x: number;
  /** One-based terminal row. */
  readonly y: number;
  readonly action: MouseClickAction;
}

export interface MouseMove {
  /** One-based terminal column. */
  readonly x: number;
  /** One-based terminal row. */
  readonly y: number;
}

export interface MouseInputParseResult {
  readonly consumed: boolean;
  readonly directions: readonly MouseWheelDirection[];
  readonly clicks: readonly MouseClick[];
  readonly moves: readonly MouseMove[];
  /** Non-mouse text from the same input event, if any. */
  readonly remaining: string;
}

export interface MouseInputParserOptions {
  /** Clock used for expiring split X10 packets; injectable for tests. */
  readonly now?: () => number;
  /** Maximum time an X10 prefix may wait for its three-byte payload. */
  readonly pendingTimeoutMs?: number;
  /**
   * Enable Ink's ESC-stripped X10 compatibility path. It is opt-in because a
   * bare `[M` is indistinguishable from ordinary composer text.
   */
  readonly allowEscStrippedX10?: boolean;
}

/** A malformed or interrupted mouse prefix must not own input indefinitely. */
export const X10_PENDING_TIMEOUT_MS = 250;
export const MOUSE_PENDING_SEQUENCE_MAX_CHARS = 96;

/**
 * Filters terminal mouse reports from Ink's key input while retaining wheel
 * direction events for transcript navigation. X10 reports are split by Ink's
 * CSI parser into the `ESC[M` prefix and the following three payload bytes, so
 * this parser keeps that small amount of state across input events.
 */
export class MouseInputParser {
  private pendingX10Prefix: string | undefined;
  private pendingX10Payload = "";
  private pendingX10StartedAt: number | undefined;
  private pendingSgr: string | undefined;
  private pendingSgrStartedAt: number | undefined;
  private readonly now: () => number;
  private readonly pendingTimeoutMs: number;
  private readonly allowEscStrippedX10: boolean;

  constructor(options: MouseInputParserOptions = {}) {
    this.now = options.now ?? Date.now;
    this.allowEscStrippedX10 = options.allowEscStrippedX10 ?? false;
    const timeout = options.pendingTimeoutMs ?? X10_PENDING_TIMEOUT_MS;
    this.pendingTimeoutMs = Number.isFinite(timeout) && timeout > 0
      ? Math.min(timeout, 1_000)
      : X10_PENDING_TIMEOUT_MS;
  }

  /** Clear an incomplete X10 report without discarding a pending SGR literal. */
  resetX10(): void {
    this.pendingX10Prefix = undefined;
    this.pendingX10Payload = "";
    this.pendingX10StartedAt = undefined;
  }

  /** Clear all incomplete protocol state when the input lifecycle resets. */
  reset(): void {
    this.resetX10();
    this.pendingSgr = undefined;
    this.pendingSgrStartedAt = undefined;
  }

  push(input: string): MouseInputParseResult {
    const directions: MouseWheelDirection[] = [];
    const clicks: MouseClick[] = [];
    const moves: MouseMove[] = [];
    let consumed = false;
    let remaining = "";
    let index = 0;

    if (
      this.pendingX10Prefix !== undefined &&
      this.pendingX10StartedAt !== undefined &&
      this.now() - this.pendingX10StartedAt >= this.pendingTimeoutMs
    ) {
      remaining = this.pendingX10Prefix + this.pendingX10Payload;
      this.pendingX10Prefix = undefined;
      this.pendingX10Payload = "";
      this.pendingX10StartedAt = undefined;
      consumed = true;
    }

    if (this.pendingSgr !== undefined) {
      const pending = this.pendingSgr;
      const startedAt = this.pendingSgrStartedAt ?? this.now();
      this.pendingSgr = undefined;
      this.pendingSgrStartedAt = undefined;
      if (this.now() - startedAt >= this.pendingTimeoutMs) {
        remaining += pending;
        consumed = true;
      } else {
        const combined = pending + input;
        if (matchSgrAt(combined) !== undefined) {
          input = combined;
        } else if (isPartialSgr(combined)) {
          this.pendingSgr = combined;
          this.pendingSgrStartedAt = startedAt;
          return { consumed: true, directions, clicks, moves, remaining };
        } else {
          remaining += pending;
        }
      }
    }

    while (index < input.length) {
      if (this.pendingX10Prefix !== undefined) {
        const pendingLength = Array.from(this.pendingX10Payload).length;
        const characters = Array.from(input.slice(index));
        const firstPayloadCode = characters[0]?.codePointAt(0);
        if (
          pendingLength === 0 &&
          (firstPayloadCode === undefined ||
            firstPayloadCode < 32 ||
            firstPayloadCode === 127 ||
            (this.pendingX10Prefix === "[M" && !isBareX10ButtonByte(firstPayloadCode)))
        ) {
          remaining += this.pendingX10Prefix;
          this.reset();
          consumed = true;
          continue;
        }
        if (
          pendingLength === 0 &&
          this.pendingX10Prefix === "[M" &&
          characters.length > 4
        ) {
          remaining += this.pendingX10Prefix + input.slice(index);
          this.reset();
          consumed = true;
          break;
        }
        const takeCount = Math.min(3 - pendingLength, characters.length);
        const payload = characters.slice(0, takeCount).join("");
        this.pendingX10Payload += payload;
        index += payload.length;
        consumed = true;

        if (Array.from(this.pendingX10Payload).length < 3) {
          break;
        }

        const packet = this.pendingX10Prefix + this.pendingX10Payload;
        const event = decodeX10Packet(this.pendingX10Payload);
        this.reset();
        if (event === undefined) {
          // Preserve malformed packets so the normal key router can see them.
          remaining += packet;
        } else if (event.kind === "direction") {
          directions.push(event.direction);
        } else if (event.kind === "move") {
          moves.push({ x: event.x, y: event.y });
        } else {
          clicks.push({
            button: event.button,
            x: event.x,
            y: event.y,
            action: event.action,
          });
        }
        continue;
      }

      const sgrMatch = matchSgrAt(input, index);
      if (sgrMatch) {
        const event = decodeMouseEvent(
          Number(sgrMatch.button),
          Number(sgrMatch.x),
          Number(sgrMatch.y),
          sgrMatch.terminator === "M" ? "press" : "release",
        );
        consumed = true;
        index += sgrMatch.full.length;
        if (event === undefined) {
          remaining += sgrMatch.full;
        } else if (event.kind === "direction") {
          directions.push(event.direction);
        } else if (event.kind === "move") {
          moves.push({ x: event.x, y: event.y });
        } else {
          clicks.push({
            button: event.button,
            x: event.x,
            y: event.y,
            action: event.action,
          });
        }
        continue;
      }

      const partialSgr = input.slice(index);
      if (isPartialSgr(partialSgr)) {
        this.pendingSgr = partialSgr;
        this.pendingSgrStartedAt = this.now();
        consumed = true;
        break;
      }

      const x10Prefix = input.startsWith("\u001b[M", index)
        ? 3
        : this.allowEscStrippedX10 && input.startsWith("[M", index)
          ? 2
          : 0;
      if (x10Prefix > 0) {
        const prefix = input.slice(index, index + x10Prefix);
        const suffix = Array.from(input.slice(index + x10Prefix));
        const isEscFramed = prefix === "\u001b[M";
        if (suffix.length >= 3) {
          const packet = suffix.slice(0, 3).join("");
          const event = isEscFramed ||
              (suffix.length === 3 && isBareX10ButtonByte(packet.codePointAt(0) ?? -1))
            ? decodeX10Packet(packet)
            : undefined;
          if (event !== undefined) {
            consumed = true;
            index += x10Prefix + packet.length;
            if (event.kind === "direction") {
              directions.push(event.direction);
            } else if (event.kind === "move") {
              moves.push({ x: event.x, y: event.y });
            } else {
              clicks.push({
                button: event.button,
                x: event.x,
                y: event.y,
                action: event.action,
              });
            }
            continue;
          }
          // A bare `[M` can be ordinary text. Only the ESC-framed packet is
          // safe to decode when its payload is in the same input event.
          remaining += prefix;
          consumed = true;
          index += x10Prefix;
          continue;
        }
        if (isEscFramed && suffix.length > 0) {
          // A real ESC-framed report can be split between its prefix and
          // payload in one stdin chunk. Keep the bytes and complete it on the
          // next event instead of leaking or dropping the partial packet.
          this.pendingX10Prefix = prefix;
          this.pendingX10Payload = suffix.join("");
          this.pendingX10StartedAt = this.now();
          consumed = true;
          index += x10Prefix + suffix.join("").length;
          continue;
        }
        if (suffix.length > 0) {
          // Do not reinterpret `[M` plus same-event text as a packet. A
          // genuine split report arrives with the prefix at the event end.
          remaining += prefix;
          consumed = true;
          index += x10Prefix;
          continue;
        }
        this.pendingX10Prefix = prefix;
        this.pendingX10Payload = "";
        this.pendingX10StartedAt = this.now();
        consumed = true;
        index += x10Prefix;
        continue;
      }

      const codePoint = input.codePointAt(index);
      if (codePoint === undefined) break;
      const character = String.fromCodePoint(codePoint);
      remaining += character;
      index += character.length;
    }

    return { consumed, directions, clicks, moves, remaining };
  }
}

type DecodedMouseEvent =
  | { readonly kind: "direction"; readonly direction: MouseWheelDirection }
  | { readonly kind: "move"; readonly x: number; readonly y: number }
  | {
      readonly kind: "click";
      readonly button: number;
      readonly x: number;
      readonly y: number;
      readonly action: MouseClickAction;
    };

interface SgrMatch {
  readonly full: string;
  readonly button: string;
  readonly x: string;
  readonly y: string;
  readonly terminator: "M" | "m";
}

function matchSgrAt(input: string, index = 0): SgrMatch | undefined {
  const candidate = input.slice(index, index + MOUSE_PENDING_SEQUENCE_MAX_CHARS);
  let cursor = 0;
  if (candidate[cursor] === "\u001b") cursor += 1;
  if (candidate[cursor] !== "[" || candidate[cursor + 1] !== "<") return undefined;
  cursor += 2;
  const fields: string[] = [];
  let field = "";
  while (cursor < candidate.length) {
    const character = candidate[cursor];
    if (character !== undefined && character >= "0" && character <= "9") {
      field += character;
      cursor += 1;
      continue;
    }
    if (character === ";") {
      if (field.length === 0 || fields.length >= 2) return undefined;
      fields.push(field);
      field = "";
      cursor += 1;
      continue;
    }
    if ((character === "M" || character === "m") && field.length > 0 && fields.length === 2) {
      return {
        full: candidate.slice(0, cursor + 1),
        button: fields[0]!,
        x: fields[1]!,
        y: field,
        terminator: character,
      };
    }
    return undefined;
  }
  return undefined;
}

function isPartialSgr(input: string): boolean {
  if (input.length === 0 || input.length > MOUSE_PENDING_SEQUENCE_MAX_CHARS) return false;
  let cursor = 0;
  if (input[cursor] === "\u001b") cursor += 1;
  if (input[cursor] !== "[") return false;
  cursor += 1;
  // Do not hold a plain `[` or `ESC[` in the protocol buffer: those are
  // ordinary text/control prefixes and must remain immediately available to
  // the composer. The `<` marker makes the SGR candidate unambiguous.
  if (input[cursor] !== "<") return false;
  cursor += 1;
  if (cursor === input.length) return true;

  let fields = 0;
  let fieldLength = 0;
  for (; cursor < input.length; cursor += 1) {
    const character = input[cursor];
    if (character !== undefined && character >= "0" && character <= "9") {
      fieldLength += 1;
      continue;
    }
    if (character === ";" && fieldLength > 0 && fields < 2) {
      fields += 1;
      fieldLength = 0;
      continue;
    }
    return false;
  }
  return true;
}

function isBareX10ButtonByte(byte: number): boolean {
  const button = byte - 32;
  // Ink has already removed ESC from bare `[M` CSI events, so text and an X10
  // payload are indistinguishable. Keep this compatibility path conservative:
  // accept the primary buttons and unmodified wheel codes only. ESC-framed
  // packets still use the complete decoder below.
  return button >= 0 && button <= 3 || button === 64 || button === 65;
}

function decodeX10Packet(payload: string): DecodedMouseEvent | undefined {
  const bytes = Array.from(payload).map((character) => character.charCodeAt(0));
  if (bytes.length !== 3) return undefined;
  const buttonByte = bytes[0] ?? 0;
  if (!Number.isInteger(buttonByte) || buttonByte < 32 || buttonByte > 255) {
    return undefined;
  }
  const button = buttonByte - 32;
  // Wheel reports carry no meaningful coordinate contract for this parser;
  // accept their legacy payload bytes because some terminals use control-byte
  // coordinates. Clicks and motion still require valid encoded coordinates.
  if ((button & 64) !== 0) {
    return { kind: "direction", direction: (button & 1) === 0 ? "up" : "down" };
  }
  const xByte = bytes[1] ?? 0;
  const yByte = bytes[2] ?? 0;
  if (
    !Number.isInteger(xByte) ||
    !Number.isInteger(yByte) ||
    xByte < 32 ||
    xByte > 255 ||
    yByte < 32 ||
    yByte > 255
  ) {
    return undefined;
  }
  return decodeMouseEvent(
    button,
    xByte - 32,
    yByte - 32,
    (button & 3) === 3 ? "release" : "press",
  );
}

function decodeMouseEvent(
  button: number,
  x: number,
  y: number,
  action: MouseClickAction,
): DecodedMouseEvent | undefined {
  if (!Number.isSafeInteger(button) || button < 0) return undefined;
  if (!Number.isSafeInteger(x) || !Number.isSafeInteger(y) || x <= 0 || y <= 0) {
    return undefined;
  }
  if ((button & 64) !== 0) {
    return { kind: "direction", direction: (button & 1) === 0 ? "up" : "down" };
  }
  if ((button & 32) !== 0) {
    return { kind: "move", x, y };
  }
  return { kind: "click", button, x, y, action };
}

// 1003 reports pointer movement without requiring a button to be held; 1006
// keeps coordinates in the SGR format so modern terminals can report rows and
// columns larger than the legacy X10 byte range.
export const MOUSE_TRACKING_ENABLE = "\u001b[?1003h\u001b[?1006h";
export const MOUSE_TRACKING_DISABLE = "\u001b[?1006l\u001b[?1003l";

/**
 * Parses the two mouse protocols commonly emitted by macOS Terminal and
 * iTerm2. Ink's input pipeline may pass the sequence to useInput with its
 * leading ESC byte removed, so both forms are accepted without treating a
 * wheel event as prompt text.
 */
export function mouseWheelDirections(input: string): MouseWheelDirection[] {
  return [...new MouseInputParser().push(input).directions];
}
