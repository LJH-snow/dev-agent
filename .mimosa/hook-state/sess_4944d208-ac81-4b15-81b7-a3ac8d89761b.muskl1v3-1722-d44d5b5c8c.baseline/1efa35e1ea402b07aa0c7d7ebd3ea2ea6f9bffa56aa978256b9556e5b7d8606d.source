import assert from "node:assert/strict";
import test from "node:test";
import { readFile } from "node:fs/promises";
import { runInNewContext } from "node:vm";

const htmlUrl = new URL("../public/index.html", import.meta.url);
async function navigation({top = 100, height = 1000, viewport = 400, pending = false, hasMessages = true} = {}) {
  const html = await readFile(htmlUrl, "utf8");
  const code = html.match(/    function isMessagesAtBottom\(\) \{[\s\S]*?(?=    function clearPendingLiveOutput)/)?.[0];
  assert.ok(code);
  const attributes = new Map();
  const label: any = {};
  const jumpToLatestButton: any = { hidden: true, dataset: {}, setAttribute: (k, v) => attributes.set(k, v) };
  const context = {messages:{scrollTop:top,scrollHeight:height,clientHeight:viewport,querySelector: () => hasMessages ? {} : null},pendingLiveOutput:pending,
    MESSAGE_SCROLL_THRESHOLD:24,jumpToLatestButton,jumpToLatestLabel:label,
    t:(key) => key,setLocalizedNode:(node,key)=>{node.textContent=key;}};
  runInNewContext(code + "\nrenderLiveOutputNotice();", context);
  return {button:jumpToLatestButton,label,attributes};
}

test("completed history exposes a return-to-latest control when reading above bottom", async () => {
  const result = await navigation();
  assert.equal(result.button.hidden, false);
  assert.equal(result.label.textContent, "conversation.jumpLatest");
  assert.equal(result.attributes.get("aria-label"), "conversation.jumpLatest");
});
test("new streaming output has a distinct label without moving the reader", async () => {
  const result = await navigation({pending:true});
  assert.equal(result.button.hidden, false);
  assert.equal(result.label.textContent, "conversation.newOutput");
  assert.equal(result.button.dataset.pending, "true");
});
test("return control stays hidden near bottom and for non-overflowing content", async () => {
  assert.equal((await navigation({top:590})).button.hidden, true);
  assert.equal((await navigation({top:0,height:300})).button.hidden, true);
});
test("empty conversation never shows a return-to-latest control on a tall narrow page", async () => {
  assert.equal((await navigation({top:0,height:5000,viewport:400,hasMessages:false})).button.hidden, true);
});
test("conversation remeasures on scroll and resize without animated token-by-token scrolling", async () => {
  const html = await readFile(htmlUrl,"utf8");
  assert.match(html, /messages\.addEventListener\("scroll",[\s\S]{0,400}renderLiveOutputNotice\(\)/);
  assert.match(html, /new ResizeObserver/);
  const styles = await readFile(new URL("../public/styles.css", import.meta.url), "utf8");
  assert.match(styles, /prefers-reduced-motion: reduce/);
});

test("narrow layouts keep transcript and composer in a bounded viewport", async () => {
  const styles = await readFile(new URL("../public/styles.css", import.meta.url), "utf8");
  const narrow = styles.slice(styles.indexOf("/* Narrow-window reading keeps"));
  assert.match(narrow, /\.app-shell\s*\{[^}]*height:\s*100dvh/);
  assert.match(narrow, /\.conversation-workspace\s*\{[^}]*min-height:\s*0;[^}]*flex:\s*1 1 0/);
  assert.match(narrow, /#messages\s*\{[^}]*min-height:\s*0/);
  assert.match(narrow, /\.inspector-shell\s*\{[^}]*position:\s*absolute/);
});
