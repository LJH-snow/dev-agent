        assert.equal(loadMore.hidden, true);
    }
    finally {
        ui.destroy();
    }
});
test("execution center treats renamed history as a new session baseline and clears deleted-session unread state", async () => {
    const alpha = historyRecord("alpha", 1);
    const beta = { ...alpha, sessionId: "beta" };
    const payloads = [
        {
            currentSessionId: "alpha",
            historySessionId: "alpha",
            sessions: [{ sessionId: "alpha", title: "Alpha", status: "done", active: false, stage: "done" }],
            history: [alpha],
        },
        {
            currentSessionId: "beta",
            historySessionId: "beta",
            sessions: [{ sessionId: "beta", title: "Beta", status: "done", active: false, stage: "done" }],
            history: [beta],
        },
        {
            currentSessionId: "beta",
            historySessionId: "beta",
            sessions: [],
            history: [],
        },
    ];
    const { documentRef, ui } = await createHistoryFilterHarness([], undefined, [[]], undefined, undefined, undefined, payloads);
    try {
        await ui.refresh();
        await ui.refresh();
        assert.equal(documentRef.getElementById("execution-center-history-unread")?.hidden, true);
        await ui.refresh();
        assert.equal(documentRef.getElementById("execution-center-history-unread")?.hidden, true);
        assert.equal(documentRef.getElementById("execution-center-history")?.hidden, true);
    }
    finally {
        ui.destroy();
    }
});
test("history evidence URL encodes safe ids and fails closed on oversized filters", async () => {
    const modulePath = fileURLToPath(new URL("../public/execution-center.js", import.meta.url));
    const module = await import(pathToFileURL(modulePath).href);
    const buildUrl = module.buildExecutionHistoryEvidenceUrl;
    assert.equal(typeof buildUrl, "function");
    assert.equal(buildUrl("task-one", { validationId: "validation?one", changeSetId: "change&one" }), "/api/sessions/task-one/messages?validationId=validation%3Fone&changeSetId=change%26one");
    assert.equal(buildUrl("task", { validationId: "v".repeat(97), changeSetId: "change-one" }), null);
    assert.equal(buildUrl("task", { changeSetId: "../private" }), null);
});
test("history detail opens the selected run and routes only its bounded evidence ids", async () => {
    const modulePath = fileURLToPath(new URL("../public/execution-center.js", import.meta.url));
    const { createExecutionCenterUI } = await import(pathToFileURL(modulePath).href);
    const documentRef = new FakeDocument();
    const ids = [
        "execution-center-status",
        "execution-center-runtime",
        "execution-center-summary",
        "execution-center-list",
        "execution-center-refresh",
        "execution-center-detail",
        "execution-center-detail-title",
        "execution-center-detail-status",
        "execution-center-detail-meta",
        "execution-center-stop",
        "execution-center-trace",
        "execution-center-validation",
        "execution-center-autofix",
        "execution-center-history",
        "execution-center-history-status",
        "execution-center-history-list",
        "execution-center-history-detail",
        "execution-center-history-detail-title",
        "execution-center-history-detail-status",
        "execution-center-history-detail-meta",
        "execution-center-history-validation",
        "execution-center-history-change-set",
    ];
    for (const id of ids)
        documentRef.elements.set(id, new FakeElement());
    const calls = [];
    const history = historyRecord("desktop-default", 4);
    const ui = createExecutionCenterUI({
        documentRef,
        translate: (key) => key,
        fetcher: async () => ({
            ok: true,
            async json() {
                return {
                    currentSessionId: "desktop-default",
                    historySessionId: "desktop-default",
                    sessions: [{
                            sessionId: "desktop-default",
                            title: "Demo task",
                            status: "done",
                            active: false,
                            stage: "done",
                        }],
                    history: [history],
                };
            },
        }),
        activateSession: async (sessionId) => { calls.push(["activate", sessionId]); },
        openValidationEvidence: async (...args) => { calls.push(["validation", ...args]); },
        openChangeSetEvidence: async (...args) => { calls.push(["change-set", ...args]); },
    });
    const previousElement = globalThis.Element;
    globalThis.Element = FakeElement;
    try {
        await ui.refresh();
        const historyList = documentRef.getElementById("execution-center-history-list");
        const runButton = historyList.children[0]?.children[0]?.children[0];
        assert.ok(runButton, "history row should expose a keyboard-accessible selection button");
        historyList.listeners.get("click")?.({ target: runButton });
        const detail = documentRef.getElementById("execution-center-history-detail");
        assert.equal(detail.hidden, false);
        assert.equal(documentRef.getElementById("execution-center-history-detail-title")?.textContent, history.runId);
        assert.equal(documentRef.getElementById("execution-center-history-validation")?.disabled, false);
        assert.equal(documentRef.getElementById("execution-center-history-change-set")?.disabled, false);
        documentRef.getElementById("execution-center-history-validation")?.listeners.get("click")?.({ target: null });
        documentRef.getElementById("execution-center-history-change-set")?.listeners.get("click")?.({ target: null });
        assert.deepEqual(calls, [
            ["validation", "desktop-default", "validation-4", "change-set-4"],
            ["change-set", "desktop-default", "change-set-4"],
        ]);
    }
    finally {
        if (previousElement === undefined)
            delete globalThis.Element;
        else
            globalThis.Element = previousElement;
        ui.destroy();
    }
});
